# Public URL of the site, used for canonical links, sitemaps and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://example.org
# Build all ~31,000 BSB verse pages at build time instead of on first visit.
# PRERENDER_ALL_VERSES=1

# Verse of the day email (Resend). Leave unset to keep the signup form switched off.
# RESEND_API_KEY=re_...
# RESEND_AUDIENCE_ID=...
# EMAIL_FROM=Lamplight <verse@yourdomain>
# Long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=...

# Where the Donate button goes (Stripe Payment Link, Ko-fi, PayPal, etc.). Leave unset to show "coming soon".
# NEXT_PUBLIC_DONATE_URL=https://...
